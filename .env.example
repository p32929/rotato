PORT=8990
ADMIN_PASSWORD=your-secure-password

# Providers are normally added from the admin panel (http://localhost:8990/admin),
# which is the recommended way. You can also declare them here, with this pattern:
#
#   {API_TYPE}_{PROVIDER_NAME}_API_KEYS   comma-separated, REQUIRED
#   {API_TYPE}_{PROVIDER_NAME}_BASE_URL   optional, defaults to the provider's own
#   {API_TYPE}_{PROVIDER_NAME}_ACCESS_KEY optional, locks the endpoint down
#
# API_TYPE must be OPENAI or GEMINI — it selects which wire format is used.
# PROVIDER_NAME is yours to pick; it becomes the URL path (/gemini, /groq, ...).
#
# A provider whose _API_KEYS is EMPTY is skipped entirely: it never gets registered,
# so requests to its path come back with a missing/invalid Authorization header.
# If you are seeing that, this is almost always why.
#
# GEMINI_GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2
# GEMINI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
#
# OPENAI_GROQ_API_KEYS=gsk_key1,gsk_key2
# OPENAI_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional outbound proxy (managed from the admin panel → Proxy tab)
# Route upstream API requests through one or more proxies, rotated per request.
# Supported schemes: http://, https://, socks5://  (with optional user:pass@)
# PROXY_ENABLED=true
# PROXY_URLS=http://user:pass@host:port,socks5://host:1080
