PORT=8990
ADMIN_PASSWORD=your-secure-password

# Optional outbound proxy (managed from the admin panel → Proxy tab)
# Supported schemes: http://, https://, socks4://, socks5://  (with optional user:pass@)
# PROXY_URLS=http://user:pass@host:port,socks5://host:1080
#
# Proxying is opted into per provider, so only the ones you name are routed:
# OPENAI_GROQ_PROXY=true
# Proxies are ranked by measured latency; only the fastest few carry traffic.
#
# Automatically fetch free public proxies (SOCKS4 + SOCKS5) from monosans/proxy-list,
# validate every entry and keep the ones that work. Can be used on its own, with no
# PROXY_URLS at all. The fetched pool is held in memory and never written here.
# PROXY_AUTO_FETCH=true

# API request logs (optional; also editable in the admin panel under Settings).
# Logging is always on - this only picks where it lives.
#   memory  each request kept in RAM only, last 100, cleared on restart (default)
#   <N>D    one file per request under logs/<date>/ with the full request and
#           response, kept for N days, older days deleted automatically
# API_LOGS=7D
